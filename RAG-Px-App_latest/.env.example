# Copy to .env for local runs (never commit real values). On Azure set these as App Service application settings.
LLM_MODE=azure
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=<chat deployment name, e.g. gpt-5.4-mini>
AZURE_OPENAI_EMBED_DEPLOYMENT=<embedding deployment name, e.g. text-embedding-3-small>
TRAINING_API_KEY=<long random string shared with learners>
DEFAULT_TEMPERATURE=0.2
DEFAULT_TOP_P=0.9
UNSAFE_NO_CONFIRM_GUARD=0
